# 直接 export（程序只读环境变量，不读取 .env 文件）；所有值都是示例，不含真实密钥。
# 数据目录（默认 ~/.local/share/holdbook）
# HOLDBOOK_DATA_DIR=/home/you/.local/share/holdbook

# 单独指定库文件（默认 <data_dir>/holdbook.db）
# HOLDBOOK_DB_PATH=/home/you/.local/share/holdbook/holdbook.db

# 行情：off / live / mock（默认 off）
HOLDBOOK_MARKET=off

# 行情基地址；示例域名仅用于说明，真实默认是 https://qt.gtimg.cn/q
# HOLDBOOK_QUOTE_BASE_URL=https://example.com/q

# 行情超时秒数 1–60；重试次数 0–5
# HOLDBOOK_MARKET_TIMEOUT=8
# HOLDBOOK_MARKET_RETRIES=2

# 导入上限
# HOLDBOOK_MAX_IMPORT_BYTES=104857600
# HOLDBOOK_MAX_IMPORT_ROWS=200000

# 对账成本容差：绝对 1.00 元或快照成本的 0.5%，取较大值
# HOLDBOOK_COST_TOLERANCE_ABS=1.00
# HOLDBOOK_COST_TOLERANCE_PCT=0.5

# 固定“今天”/“现在”，用于复现；日常不要设置
# HOLDBOOK_TODAY=2026-10-29
# HOLDBOOK_NOW=2026-10-29T12:00:00Z
